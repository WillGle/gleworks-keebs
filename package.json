{
  "name": "glework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-logged.mjs dev vite",
    "build": "node scripts/run-logged.mjs build sh -c \"tsc && vite build\"",
    "preview": "node scripts/run-logged.mjs preview vite preview",
    "lint": "node scripts/run-logged.mjs lint eslint .",
    "lint:fix": "node scripts/run-logged.mjs lint-fix eslint . --fix",
    "type-check": "node scripts/run-logged.mjs types tsc --noEmit",
    "test": "node scripts/run-logged.mjs test-watch vitest",
    "test:ui": "node scripts/run-logged.mjs test-ui vitest --ui",
    "test:run": "node scripts/run-logged.mjs unit vitest run",
    "test:coverage": "node scripts/run-logged.mjs coverage vitest run --coverage",
    "test:build": "node scripts/run-logged.mjs artifact sh -c \"npm run build && node --test scripts/test-build.mjs\"",
    "test:vite": "node scripts/run-logged.mjs vite sh -c \"npm run build && node --test scripts/test-vite.mjs\"",
    "test:e2e": "node scripts/run-logged.mjs e2e playwright test",
    "test:container": "node scripts/run-logged.mjs container bash scripts/test-container.sh",
    "test:ci": "node scripts/run-logged.mjs ci sh -c \"npm run lint && npm run type-check && npm run test:coverage && npm run test:build && npm run test:vite && npm run test:e2e && npm run test:audit\"",
    "test:audit": "node scripts/run-logged.mjs audit npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
